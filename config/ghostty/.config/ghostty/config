# Ghostty configuration

theme = catppuccin-macchiato.conf

font-family = Iosevka Nerd Font
font-size = 14

# Window configuration
# window-decoration = false # Uncomment to disable window decorations. Note: this will disable tabs.

# Scroll configuration
scrollback-limit = 100000

# Automatically copy selected text to clipboard
copy-on-select = clipboard

unfocused-split-opacity = 0.5

# Send TERM=xterm-256color to ssh targets instead of xterm-ghostty, which they
# have no terminfo entry for. Local sessions keep xterm-ghostty and its full
# capabilities. Omitted features keep their defaults.
shell-integration-features = ssh-env
